# Dependências
node_modules/

# Variáveis de ambiente (mantém apenas os modelos sem segredos)
.env
.env.*
!.env.example
!.env.docker
!.env.tls
!.env.vault

# Chaves dos JWTs (geradas por npm run kong:setup) e configuração do Kong gerada a partir do template
keys/
# CA local e certificados TLS (gerados por npm run tls:setup)
certs/
# Vault local (segredos entregues pelo Agent, credenciais do AppRole, estado do OpenTofu)
.vault/

# OpenTofu: providers baixados e estados (o .terraform.lock.hcl é versionado)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!infra/vault/envs/local.tfvars
kong/kong.yml

# Build e cobertura
dist/
coverage/
*.tsbuildinfo

# Caches de ferramentas
.eslintcache
.npm/

# Logs
logs/
*.log
npm-debug.log*

# Editores e sistema operacional
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
