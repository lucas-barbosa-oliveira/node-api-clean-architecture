# Exemplo para um cluster Kubernetes. Copie (ex.: envs/production.tfvars, fora do git ou no repositório da plataforma)
# e ajuste. Nenhum valor secreto aqui: senhas de administração vêm de TF_VAR_mongodb_password e
# TF_VAR_rabbitmq_password no pipeline, e os segredos estáticos são gravados direto no Vault (vault kv put).
environment = "production"

pki = {
  api_domains = [
    "api-clean-architecture",
    "api-clean-architecture.api.svc",
    "api-clean-architecture.api.svc.cluster.local",
  ]
  infra_domains = [
    "mongodb.data.svc.cluster.local",
    "redis.data.svc.cluster.local",
    "rabbitmq.messaging.svc.cluster.local",
    "influxdb.data.svc.cluster.local",
    "kong-gateway-proxy.kong.svc.cluster.local",
  ]
  leaf_ttl     = "72h"
  leaf_max_ttl = "720h"
}

mongodb = {
  connection_url = "mongodb://{{username}}:{{password}}@mongodb.data.svc.cluster.local:27017/admin?tls=true&replicaSet=rs0"
  username       = "vault-admin"
  roles          = [{ role = "readWrite", db = "app" }]
  default_ttl    = 3600
  max_ttl        = 86400
}

rabbitmq = {
  connection_uri = "https://rabbitmq.messaging.svc.cluster.local:15671" # CA no trust store do Vault (SSL_CERT_FILE)
  username       = "vault-admin"
  vhost          = "/"
}

generate_jwt_keys = true # com estado cifrado (TF_ENCRYPTION); ou false e grave a chave com vault kv put
static_secrets    = null # influx_token, admin_password, redis_password: vault kv put kv/api/static ...

kubernetes = {
  host             = "https://kubernetes.default.svc"
  namespaces       = ["api"]
  service_accounts = ["api-clean-architecture"]
  audience         = "vault"
}

transit = {
  key_name           = "mfa"
  auto_rotate_period = 2592000
}

audit_file_path = "/vault/audit/audit.log"
