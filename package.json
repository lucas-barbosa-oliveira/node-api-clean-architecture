{
  "name": "api-clean-architecture",
  "version": "1.0.0",
  "description": "API Node.js com Express 5, TypeScript nativo e Clean Architecture (Mongo, Redis/BullMQ, InfluxDB, RabbitMQ, JWT com refresh token + Kong Gateway)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import ./src/main/telemetry.ts src/main/server.ts",
    "dev:docker": "node --watch --env-file=.env.docker --import ./src/main/telemetry.ts src/main/server.ts",
    "start": "node --env-file-if-exists=.env --import ./src/main/telemetry.ts src/main/server.ts",
    "start:docker": "node --env-file=.env.docker --import ./src/main/telemetry.ts src/main/server.ts",
    "dev:docker:tls": "node --watch --env-file=.env.docker --env-file=.env.tls --import ./src/main/telemetry.ts src/main/server.ts",
    "start:docker:tls": "node --env-file=.env.docker --env-file=.env.tls --import ./src/main/telemetry.ts src/main/server.ts",
    "dev:docker:vault": "node --watch --env-file=.env.docker --env-file=.env.tls --env-file=.env.vault --import ./src/main/telemetry.ts src/main/server.ts",
    "start:docker:vault": "node --env-file=.env.docker --env-file=.env.tls --env-file=.env.vault --import ./src/main/telemetry.ts src/main/server.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:docker": "node --env-file=.env.docker --test \"test/**/*.test.ts\"",
    "test:docker:tls": "node --env-file=.env.docker --env-file=.env.tls --test \"test/**/*.test.ts\"",
    "test:docker:vault": "node --env-file=.env.docker --env-file=.env.tls --env-file=.env.vault --test \"test/**/*.test.ts\"",
    "typecheck": "node ./node_modules/typescript7/bin/tsc --noEmit",
    "kong:setup": "node --env-file-if-exists=.env.docker scripts/setup.kong.ts",
    "db:migrate": "node --env-file-if-exists=.env src/main/migrate.ts",
    "db:migrate:docker": "node --env-file=.env.docker src/main/migrate.ts",
    "tls:setup": "node scripts/setup.tls.ts",
    "vault:bootstrap": "node scripts/vault.local.ts bootstrap",
    "docker:build": "docker compose build api",
    "docker:up": "KONG_UPSTREAM_URL=http://api:3000 KONG_RATE_LIMIT_REDIS_HOST=redis npm run kong:setup && docker compose up -d --build --wait && docker compose up -d --wait --no-deps --force-recreate kong",
    "docker:infra": "KONG_UPSTREAM_URL=http://host.docker.internal:3000 KONG_RATE_LIMIT_REDIS_HOST=redis npm run kong:setup && docker compose up -d --wait mongo redis influxdb rabbitmq lgtm kong && docker compose up -d --wait --no-deps --force-recreate kong",
    "docker:up:tls": "npm run tls:setup && KONG_UPSTREAM_URL=https://api:3000 npm run kong:setup && docker compose -f docker-compose.yml -f docker-compose.tls.yml up -d --build --wait && docker compose -f docker-compose.yml -f docker-compose.tls.yml up -d --wait --no-deps --force-recreate kong",
    "docker:infra:tls": "npm run tls:setup && KONG_UPSTREAM_URL=https://host.docker.internal:3000 npm run kong:setup && docker compose -f docker-compose.yml -f docker-compose.tls.yml up -d --wait mongo redis influxdb rabbitmq lgtm kong && docker compose -f docker-compose.yml -f docker-compose.tls.yml up -d --wait --no-deps --force-recreate kong",
    "docker:up:vault": "node scripts/vault.local.ts up",
    "docker:infra:vault": "node scripts/vault.local.ts infra",
    "docker:logs": "docker compose logs -f api",
    "docker:down": "docker compose down --remove-orphans",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "license": "ISC",
  "dependencies": {
    "@influxdata/influxdb-client": "^1.35.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-prometheus": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/instrumentation": "^0.301.2",
    "@opentelemetry/instrumentation-amqplib": "^0.72.0",
    "@opentelemetry/instrumentation-express": "^0.73.0",
    "@opentelemetry/instrumentation-http": "^0.301.2",
    "@opentelemetry/instrumentation-ioredis": "^0.73.0",
    "@opentelemetry/instrumentation-mongodb": "^0.78.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.38.0",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "amqplib": "^2.4.0",
    "bullmq": "^6.7.6",
    "croner": "^11.0.1",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.17",
    "mongoose": "^9.12.2",
    "query-strings-parser": "^2.1.13",
    "swagger-ui-dist": "^5.35.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "amqp-client-node": "^1.1.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "supertest": "^7.3.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript7": "npm:typescript@^7.0.2"
  }
}
