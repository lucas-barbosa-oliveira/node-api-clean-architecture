# Camada do Vault sobre .env.docker + .env.tls, para a API rodando no host contra npm run docker:infra:vault.
# Usada por: npm run dev:docker:vault | start:docker:vault | test:docker:vault
# Os arquivos de .vault/secrets são gravados pelo Vault Agent (container vault-agent) e trocados quando renovados.

# Credenciais dinâmicas (usuário temporário por instância) e segredos estáticos do KV
MONGO_USERNAME_FILE=./.vault/secrets/mongo-username
MONGO_PASSWORD_FILE=./.vault/secrets/mongo-password
RABBITMQ_URI=amqps://127.0.0.1:5671
RABBITMQ_USERNAME_FILE=./.vault/secrets/rabbitmq-username
RABBITMQ_PASSWORD_FILE=./.vault/secrets/rabbitmq-password
REDIS_PASSWORD_FILE=./.vault/secrets/redis-password
INFLUX_TOKEN=
INFLUX_TOKEN_FILE=./.vault/secrets/influx-token
ADMIN_PASSWORD=
ADMIN_PASSWORD_FILE=./.vault/secrets/admin-password
JWT_PRIVATE_KEY_PATH=./.vault/secrets/jwt-private-key
JWT_PUBLIC_KEY_PATH=./.vault/secrets/jwt-public-key

# Certificado da API emitido pela PKI do Vault (renovado pelo Agent, recarregado pela API)
TLS_CA_FILE=./.vault/secrets/ca-cert
TLS_CLIENT_CERT_FILE=./.vault/secrets/api-cert
TLS_CLIENT_KEY_FILE=./.vault/secrets/api-key
SERVER_TLS_CERT_FILE=./.vault/secrets/api-cert
SERVER_TLS_KEY_FILE=./.vault/secrets/api-key
SERVER_TLS_CA_FILE=./.vault/secrets/ca-cert

# MFA pelo Transit, via proxy do Agent (a chave local fica só para ler segredos antigos)
MFA_CIPHER=vault-transit
VAULT_ADDR=http://127.0.0.1:8100
VAULT_TRANSIT_MOUNT=local/transit
VAULT_TRANSIT_KEY=matrixgrid-api-clean-architecture

MONGO_AUTO_INDEX=false
SECRETS_RELOAD_INTERVAL_MS=10000
