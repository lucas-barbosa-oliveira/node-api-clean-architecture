# Copie para .env (opcional: sem .env o padrão já é memória + fila em processo).
#   cp .env.example .env

# Persistência: memory | mongo
REPOSITORY_DRIVER=memory
# Fila e agendador de tasks: in-process | redis
# (redis exige REPOSITORY_DRIVER=mongo, porque o estado dos jobs precisa ser compartilhado entre instâncias)
QUEUE_DRIVER=in-process

PORT=3000
# Porta só com /health* em HTTP (para probes quando a principal exige certificado de cliente). 0 desliga.
# HEALTH_PORT=8081

# ---- Segredos em arquivo (Vault Agent, Secret do Kubernetes) ----
# Qualquer segredo abaixo aceita <VAR>_FILE=/caminho no lugar do valor (ex.: MONGO_PASSWORD_FILE).
# Os arquivos são relidos periodicamente: credenciais e certificados novos valem sem reiniciar (0 desliga).
# SECRETS_RELOAD_INTERVAL_MS=30000

# ---- TLS do servidor da API (HTTPS) ----
# Certificados de desenvolvimento: npm run tls:setup (gera ./certs). Veja também .env.tls (tudo com TLS).
# SERVER_TLS=true
# SERVER_TLS_CERT_FILE=./certs/api.crt
# SERVER_TLS_KEY_FILE=./certs/api.key
# none (qualquer cliente) | require (só clientes com certificado assinado por SERVER_TLS_CA_FILE: mTLS)
# SERVER_TLS_CLIENT_AUTH=none
# SERVER_TLS_CA_FILE=./certs/ca.crt
# TLSv1.2 | TLSv1.3
# SERVER_TLS_MIN_VERSION=TLSv1.2

# ---- TLS das conexões de saída (Mongo, Redis, RabbitMQ, InfluxDB) ----
# Liga com <SERVIÇO>_TLS=true ou com o esquema seguro na URL (rediss://, amqps://, https://, tls=true no Mongo).
# Padrões para todas as conexões (cada serviço pode sobrescrever com o próprio prefixo):
# TLS_CA_FILE=./certs/ca.crt
# TLS_CLIENT_CERT_FILE=./certs/api.crt
# TLS_CLIENT_KEY_FILE=./certs/api.key
# Por serviço (prefixos MONGO_, REDIS_, RABBITMQ_, INFLUX_):
# MONGO_TLS=true
# MONGO_TLS_CA_FILE=./certs/ca.crt
# MONGO_TLS_CERT_FILE=./certs/api.crt
# MONGO_TLS_KEY_FILE=./certs/api.key
# MONGO_TLS_SERVERNAME=mongo
# false só para diagnóstico: aceita qualquer certificado do servidor
# MONGO_TLS_REJECT_UNAUTHORIZED=true

# Duração simulada do relatório de exemplo (ms), para dar tempo de ver pending -> running -> succeeded
REPORT_DURATION_MS=3000

# Necessárias quando REPOSITORY_DRIVER=mongo:
# MONGO_URI=mongodb://127.0.0.1:27017/?directConnection=true
# MONGO_DB=app
# Credenciais fora da URI (ex.: usuário temporário do Vault, em arquivo)
# MONGO_USERNAME_FILE=./.vault/secrets/mongo-username
# MONGO_PASSWORD_FILE=./.vault/secrets/mongo-password
# MONGO_AUTH_SOURCE=admin
# Cria os índices na inicialização (false quando vêm de npm run db:migrate)
# MONGO_AUTO_INDEX=true
# Necessária quando QUEUE_DRIVER=redis:
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_PASSWORD=

# ---- Autenticação (JWT RS256) ----
# Par de chaves RSA: a privada assina os tokens (só a API tem), a pública valida (API e Kong).
# Gere com: npm run kong:setup. Sem as duas variáveis, a API usa chaves temporárias (tokens morrem ao reiniciar).
JWT_PRIVATE_KEY_PATH=./keys/jwt.private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt.public.pem
# "iss" dos tokens: precisa ser igual à "key" do consumer em kong/kong.template.yml (o script já usa este valor)
JWT_ISSUER=api-clean-architecture
JWT_AUDIENCE=api-clean-architecture
# Access token curto (15 min); a renovação é feita com o refresh token
JWT_EXPIRES_IN_SECONDS=900
# Validade absoluta da sessão / refresh token (7 dias). Depois disso, só com novo login
REFRESH_TOKEN_TTL_SECONDS=604800

# Administrador criado na inicialização (se ainda não existir). Troque a senha fora do ambiente local.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=admin-local-123

# ---- Autenticação multifator (TOTP + códigos de recuperação) ----
# Cifra dos segredos TOTP: local (MFA_ENCRYPTION_KEY) | vault-transit (a chave fica no Vault)
# MFA_CIPHER=local
# Com vault-transit: Vault ou Vault Agent (o Agent já injeta o token); token em arquivo se não for pelo Agent
# VAULT_ADDR=http://127.0.0.1:8100
# VAULT_TOKEN_FILE=
# VAULT_TRANSIT_MOUNT=transit
# VAULT_TRANSIT_KEY=mfa
# Chave AES-256 que cifra os segredos TOTP no banco: obrigatória com REPOSITORY_DRIVER=mongo
# (em memória, sem ela, a API usa uma chave temporária). Gere com: openssl rand -base64 32
# MFA_ENCRYPTION_KEY=
# Rotação: a chave anterior continua decifrando (os segredos são cifrados de novo no próximo uso)
# MFA_ENCRYPTION_PREVIOUS_KEYS=
# Papéis que só recebem escopos com MFA ativo e usado no login, separados por vírgula (ex.: admin)
# MFA_REQUIRED_ROLES=admin
# Nome no aplicativo autenticador (padrão: APP_NAME)
# MFA_ISSUER=api-clean-architecture
# Tempo para digitar o código depois da senha (60 a 900 s)
# MFA_CHALLENGE_TTL_SECONDS=300

# ---- Séries temporais (dados dos sensores) ----
# memory (padrão, dados somem ao reiniciar) | influx
TIMESERIES_DRIVER=memory
# INFLUX_URL=http://127.0.0.1:8086
# INFLUX_TOKEN=dev-influx-token-local
# INFLUX_ORG=app
# INFLUX_BUCKET=sensors

# ---- Dispositivos (ESP32) ----
# Validade do código de pareamento (10 min) e do token do dispositivo (1 ano; revogação é imediata)
PAIRING_CODE_TTL_SECONDS=600
DEVICE_TOKEN_TTL_SECONDS=31536000

# ---- Logs ----
# Nome do serviço: rótulo dos logs, campo "service" da auditoria e fila/exchange RPC (<APP_NAME>.rpc) no barramento
APP_NAME=api-clean-architecture
# silent | error | warn | info | debug
LOG_LEVEL=info
# text (legível) | json (uma linha JSON por log, para agregadores)
LOG_FORMAT=text

# ---- Barramento de eventos (RabbitMQ) ----
# memory (padrão: nada sai do processo) | rabbitmq
EVENT_BUS_DRIVER=memory
# RABBITMQ_URI=amqp://app:app-rabbit-local@127.0.0.1:5672
# RABBITMQ_RETRY_INTERVAL_MS=2000
# RABBITMQ_RPC_TIMEOUT_MS=5000
# Substituem os da URI (ex.: usuário temporário do Vault)
# RABBITMQ_USERNAME_FILE=./.vault/secrets/rabbitmq-username
# RABBITMQ_PASSWORD_FILE=./.vault/secrets/rabbitmq-password
# Tentativas de um subscriber antes de a mensagem ir para a fila <APP_NAME>.dlq
# RABBITMQ_SUBSCRIBER_ATTEMPTS=3
# Os eventos são gravados no outbox (mesmo banco dos dados) e publicados por um relay com novas tentativas.
# Intervalo com que o relay procura eventos gravados por outras instâncias
OUTBOX_POLL_INTERVAL_MS=1000

# ---- Auditoria (um RequestAuditEvent por requisição, exchange "audit", routing key "audit.request") ----
AUDIT_ENABLED=true
AUDIT_IGNORE_PATHS=/health,/.well-known,/reference
AUDIT_MAX_BODY_BYTES=16384

# ---- Documentação ----
# Swagger UI em /reference (documento em /reference/openapi.json e /reference/openapi.yaml)
API_DOCS_ENABLED=true

# ---- Observabilidade (OpenTelemetry) ----
# Traces, métricas e logs via OTLP (Grafana LGTM em http://localhost:3001); sem esta variável a telemetria fica desligada
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=api-clean-architecture
# Métricas no formato Prometheus em http://localhost:9464/metrics
# OTEL_METRICS_PORT=9464
# OTLP com TLS: endpoint https:// e as variáveis padrão do OpenTelemetry
# OTEL_EXPORTER_OTLP_CERTIFICATE=./certs/ca.crt
# OTEL_EXPORTER_OTLP_CLIENT_CERTIFICATE=./certs/api.crt
# OTEL_EXPORTER_OTLP_CLIENT_KEY=./certs/api.key
