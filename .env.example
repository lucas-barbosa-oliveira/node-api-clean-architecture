# Copie para .env (opcional: sem .env o padrão já é memória + fila em processo).
#   cp .env.example .env

# Persistência: memory | mongo
REPOSITORY_DRIVER=memory
# Fila e agendador de tasks: in-process | redis
# (redis exige REPOSITORY_DRIVER=mongo, porque o estado dos jobs precisa ser compartilhado entre instâncias)
QUEUE_DRIVER=in-process

PORT=3000

# Duração simulada do relatório de exemplo (ms), para dar tempo de ver pending -> running -> succeeded
REPORT_DURATION_MS=3000

# Necessárias quando REPOSITORY_DRIVER=mongo:
# MONGO_URI=mongodb://127.0.0.1:27017
# MONGO_DB=app
# Necessária quando QUEUE_DRIVER=redis:
# REDIS_URL=redis://127.0.0.1:6379

# ---- Autenticação (JWT RS256) ----
# Par de chaves RSA: a privada assina os tokens (só a API tem), a pública valida (API e Kong).
# Gere com: npm run kong:setup. Sem as duas variáveis, a API usa chaves temporárias (tokens morrem ao reiniciar).
JWT_PRIVATE_KEY_PATH=./keys/jwt.private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt.public.pem
# "iss" dos tokens: precisa ser igual à "key" do consumer em kong/kong.template.yml (o script já usa este valor)
JWT_ISSUER=api-clean-architecture
JWT_AUDIENCE=api-clean-architecture
JWT_EXPIRES_IN_SECONDS=3600

# Administrador criado na inicialização (se ainda não existir). Troque a senha fora do ambiente local.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=admin-local-123
