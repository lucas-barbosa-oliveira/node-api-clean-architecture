# Camada de TLS sobre o .env.docker, para a API rodando no host contra a infraestrutura com TLS
# (npm run docker:infra:tls). Carregado depois do .env.docker: os valores daqui prevalecem.
# Usada por: npm run dev:docker:tls | start:docker:tls | test:docker:tls
# Certificados gerados por npm run tls:setup em ./certs (desenvolvimento local, sem segredos).

# ---- Conexões de saída (API -> serviços) ----
# O TLS liga com <SERVIÇO>_TLS=true ou com o esquema seguro na URL (rediss://, amqps://, https://).
MONGO_TLS=true
REDIS_URL=rediss://127.0.0.1:6379
RABBITMQ_URI=amqps://app:app-rabbit-local@127.0.0.1:5671
INFLUX_URL=https://127.0.0.1:8086
# Padrões para todas as conexões: CA que assina os certificados dos servidores e identidade da API (mTLS).
# Cada serviço pode ter os seus: MONGO_TLS_CA_FILE, REDIS_TLS_CERT_FILE, RABBITMQ_TLS_KEY_FILE, INFLUX_TLS_SERVERNAME...
TLS_CA_FILE=./certs/ca.crt
TLS_CLIENT_CERT_FILE=./certs/api.crt
TLS_CLIENT_KEY_FILE=./certs/api.key

# ---- Servidor da API em HTTPS ----
SERVER_TLS=true
SERVER_TLS_CERT_FILE=./certs/api.crt
SERVER_TLS_KEY_FILE=./certs/api.key
# Só aceita clientes com certificado assinado por esta CA (o Kong). Para chamar a API direto, sem o Kong:
#   curl --cacert certs/ca.crt --cert certs/kong.crt --key certs/kong.key https://localhost:3000/health
SERVER_TLS_CA_FILE=./certs/ca.crt
SERVER_TLS_CLIENT_AUTH=require
SERVER_TLS_MIN_VERSION=TLSv1.2
